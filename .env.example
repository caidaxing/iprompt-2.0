# 复制为 .env 后填入真实值；真实 .env 永不提交
DATABASE_URL="file:./dev.db"            # 上线切 PostgreSQL 时改为 postgresql://...
AUTH_JWT_SECRET=""                      # 至少 16 位随机字符串
ACCESS_TOKEN_TTL_MIN=15                 # 访问令牌时效（分钟）
REFRESH_TOKEN_TTL_DAYS=30               # 刷新令牌时效（天）
CODE_TTL_MIN=5                          # 邮箱验证码时效（分钟），登录邮件文案同源
# E2E_DEV_CODE=1                        # 仅本地 E2E 测试回显验证码用；生产环境绝不能开启

# ── 邮件发送（不配置时 MAIL_PROVIDER=console，验证码仅打印到服务端日志）──
# MAIL_PROVIDER=smtp                    # console | smtp
# SMTP_HOST=""                          # 如 smtp.qq.com / smtp.163.com / smtpdm.aliyun.com
# SMTP_PORT=465                         # 465(SSL) 或 587(STARTTLS)
# SMTP_USER=""                          # 发信账号
# SMTP_PASS=""                          # 授权码（非登录密码）
# MAIL_FROM=""                          # 发件人展示，如 "iPrompt Studio <no-reply@yourdomain.com>"

# ===== SEO / 对外地址 =====
# 用于生成 canonical / OpenGraph / JSON-LD / sitemap / robots 中的绝对 URL。
# 必须设置为用户真实访问的地址(含协议,不带尾斜杠),否则搜索引擎会收到错误地址。
# 未设置时回退到 src/lib/site.ts 中的默认值。
NEXT_PUBLIC_SITE_URL=https://your-domain.com
