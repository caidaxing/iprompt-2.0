# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma 本地库
/prisma/dev.db
/prisma/dev.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地开发产物（不进仓库）
npm-install.log
.playwright-cli/
test-results/
shots/
.desc-work/

# 数据库备份（可由数据管线重建，不入库）
prisma/dev.db.backup-*

# 生产数据库快照(含用户数据,严禁入库)
/prisma/prod.db*

# 本地备份(不进仓库)
.backup/

# AI 生成产物(运行时数据,不进仓库)
/public/generations/

# 案例图本地化产物(约 7000 张 / 2GB,由 scripts/localize-case-images.mjs + manifest 重建,不进仓库)
# 该目录随 rsync 发版,不依赖 git 分发；如要版本化，应走对象存储/CDN，而不是提交进 git
/public/images/cases/localized/
